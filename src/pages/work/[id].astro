---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbList } from '../../lib/seo';
import { getPortfolioItems, scrubAgencyMentions } from '../../lib/portfolio';

export function getStaticPaths() {
  return getPortfolioItems().map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const title = scrubAgencyMentions(item.title);
const excerpt = scrubAgencyMentions(item.excerpt);
const summary = scrubAgencyMentions(item.summary);
const bodyHtml = scrubAgencyMentions(item.bodyHtml || '');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path: '/work/' },
  { name: title, path: `/work/${item.id}/` },
];
---

<BaseLayout
  title={`${title} | Work`}
  description={scrubAgencyMentions(item.seo.description)}
  canonical={item.okmgUrl}
  ogImage={item.heroImage || undefined}
  noindex={true}
  jsonLd={breadcrumbList(crumbs)}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Work', href: '/work/' }, { label: title }]}
      />
      <h1>{title}</h1>
      <p class="lead">{excerpt}</p>
      {
        item.projectUrl && (
          <div class="btn-row">
            <a class="btn btn--primary" href={item.projectUrl} rel="noopener noreferrer" target="_blank">
              Visit live site
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    item.heroImage && (
      <section class="work-hero-media">
        <div class="container">
          <img src={item.heroImage} alt="" width="1400" height="800" />
        </div>
      </section>
    )
  }

  {
    item.stats.length > 0 && (
      <section class="section" style="padding-top: 0">
        <div class="container stats">
          {item.stats.map((stat) => (
            <div>
              <strong>{scrubAgencyMentions(stat.value)}</strong>
              <span>{scrubAgencyMentions(stat.title)}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="section" style="padding-top: 0">
    <div class="container prose">
      {bodyHtml ? <div set:html={bodyHtml} /> : <p>{summary}</p>}
      {
        item.contentGroups.map((group) => (
          <div class="content-group">
            {group.html && <div set:html={scrubAgencyMentions(group.html)} />}
            {group.images.length > 0 && (
              <div class="content-group__images">
                {group.images.map((src) => (
                  <img src={src} alt="" loading="lazy" width="900" height="600" />
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .work-hero-media {
    padding-bottom: 2rem;
  }

  .work-hero-media img {
    width: 100%;
    max-height: 34rem;
    object-fit: cover;
    display: block;
    border: 1px solid var(--line);
  }

  .stats {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  .stats div {
    border-top: 3px solid var(--accent);
    padding-top: 0.85rem;
  }

  .stats strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .stats span {
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .content-group {
    margin-top: 2rem;
  }

  .content-group__images {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .content-group__images img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
  }
</style>
