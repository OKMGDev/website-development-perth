---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbList } from '../../lib/seo';
import { formatFacetLabel, getPortfolioFacets, getPortfolioItems, scrubAgencyMentions } from '../../lib/portfolio';

const work = getPortfolioItems().map((item) => ({
  ...item,
  excerpt: scrubAgencyMentions(item.excerpt),
  title: scrubAgencyMentions(item.title),
}));
const facets = getPortfolioFacets();
---

<BaseLayout
  title="Our Work | Website Projects in Perth"
  description="Browse website and digital projects — WordPress, Shopify, Webflow and custom builds for Perth businesses."
  jsonLd={breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work/' },
  ])}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Work' }]} />
      <h1>Work</h1>
      <p class="lead">
        Website and digital builds — WordPress, Shopify, Webflow and custom platforms for Perth businesses.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="work-filters" data-work-filters>
        <label class="work-filters__search">
          <span class="sr-only">Search projects</span>
          <input
            type="search"
            placeholder="Search projects…"
            data-work-search
            autocomplete="off"
          />
        </label>

        <div class="work-filters__group" role="group" aria-label="Filter by industry">
          <p class="work-filters__label">Industry</p>
          <div class="work-filters__chips">
            <button type="button" class="chip is-active" data-filter-category="all">All</button>
            {facets.categories.map((facet) => (
              <button type="button" class="chip" data-filter-category={facet.id}>
                {facet.label}
              </button>
            ))}
          </div>
        </div>

        <div class="work-filters__group" role="group" aria-label="Filter by website service">
          <p class="work-filters__label">Website service</p>
          <div class="work-filters__chips">
            <button type="button" class="chip is-active" data-filter-service="all">All</button>
            {facets.services.map((facet) => (
              <button type="button" class="chip" data-filter-service={facet.id}>
                {facet.label}
              </button>
            ))}
          </div>
        </div>

        <p class="work-filters__meta">
          <span data-work-count>{work.length}</span> projects
          <button type="button" class="work-filters__reset" data-work-reset hidden>Clear filters</button>
        </p>
      </div>

      <div class="work-grid" data-work-grid>
        {work.map((item) => (
          <a
            class="work-card"
            href={`/work/${item.id}/`}
            data-work-card
            data-title={item.title}
            data-excerpt={item.excerpt}
            data-categories={(item.categories || []).join(',')}
            data-services={(item.servicesOffered || []).join(',')}
          >
            {item.homepageImage || item.heroImage ? (
              <img
                src={item.homepageImage || item.heroImage}
                alt={`${item.title} website project`}
                loading="lazy"
                width="640"
                height="400"
              />
            ) : null}
            <div>
              {(item.categories || []).length > 0 && (
                <p class="work-card__tags">
                  {(item.categories || []).map((tag) => formatFacetLabel(tag)).join(' · ')}
                </p>
              )}
              <h2>{item.title}</h2>
              <p>{item.excerpt}</p>
              <span>View project →</span>
            </div>
          </a>
        ))}
      </div>

      <p class="work-empty" data-work-empty hidden>No projects match those filters.</p>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<script>
  const root = document.querySelector('[data-work-filters]');
  const grid = document.querySelector('[data-work-grid]');
  if (root instanceof HTMLElement && grid instanceof HTMLElement) {
    const search = root.querySelector('[data-work-search]');
    const countEl = root.querySelector('[data-work-count]');
    const resetBtn = root.querySelector('[data-work-reset]');
    const empty = document.querySelector('[data-work-empty]');
    const cards = [...grid.querySelectorAll('[data-work-card]')];

    let category = 'all';
    let service = 'all';

    const setActive = (selector: string, value: string) => {
      root.querySelectorAll(selector).forEach((btn) => {
        if (!(btn instanceof HTMLElement)) return;
        const key = selector.includes('category') ? 'filterCategory' : 'filterService';
        const attr = key === 'filterCategory' ? 'data-filter-category' : 'data-filter-service';
        btn.classList.toggle('is-active', btn.getAttribute(attr) === value);
      });
    };

    const apply = () => {
      const q = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      let visible = 0;

      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const title = (card.dataset.title || '').toLowerCase();
        const excerpt = (card.dataset.excerpt || '').toLowerCase();
        const cats = (card.dataset.categories || '').split(',').filter(Boolean);
        const services = (card.dataset.services || '').split(',').filter(Boolean);

        const matchesQuery = !q || title.includes(q) || excerpt.includes(q);
        const matchesCategory = category === 'all' || cats.includes(category);
        const matchesService = service === 'all' || services.includes(service);
        const show = matchesQuery && matchesCategory && matchesService;

        card.hidden = !show;
        if (show) visible += 1;
      }

      if (countEl) countEl.textContent = String(visible);
      if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      const filtered = Boolean(q) || category !== 'all' || service !== 'all';
      if (resetBtn instanceof HTMLElement) resetBtn.hidden = !filtered;
    };

    root.querySelectorAll('[data-filter-category]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLElement)) return;
        category = btn.getAttribute('data-filter-category') || 'all';
        setActive('[data-filter-category]', category);
        apply();
      });
    });

    root.querySelectorAll('[data-filter-service]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLElement)) return;
        service = btn.getAttribute('data-filter-service') || 'all';
        setActive('[data-filter-service]', service);
        apply();
      });
    });

    search?.addEventListener('input', apply);
    resetBtn?.addEventListener('click', () => {
      category = 'all';
      service = 'all';
      if (search instanceof HTMLInputElement) search.value = '';
      setActive('[data-filter-category]', category);
      setActive('[data-filter-service]', service);
      apply();
    });
  }
</script>

<style>
  .work-filters {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .work-filters__search input {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink);
    font: inherit;
  }

  .work-filters__search input:focus {
    outline: 1px solid var(--accent);
    border-color: var(--accent);
  }

  .work-filters__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.55rem;
  }

  .work-filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip {
    min-height: 2.1rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .work-filters__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .work-filters__reset {
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    padding: 0;
  }

  .work-grid {
    display: grid;
    gap: 1.25rem;
  }

  .work-card {
    display: grid;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .work-card[hidden] {
    display: none;
  }

  .work-card:hover {
    border-color: var(--ink);
  }

  .work-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .work-card div {
    padding: 0 1.15rem 1.15rem;
  }

  .work-card__tags {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.45rem;
  }

  .work-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .work-card p {
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .work-card span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .work-empty {
    margin-top: 2rem;
    color: var(--ink-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (min-width: 720px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
