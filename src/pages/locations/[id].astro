---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbList, faqSchema, serviceSchema } from '../../lib/seo';
import { serviceLocationPath } from '../../lib/serviceLocations';
import { getServiceIcon } from '../../lib/icons';
import { serviceGroups } from '../../data/serviceGroups';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations
    .filter((entry) => entry.data.publish)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allLocations = await getCollection('locations');
const nearby = allLocations.filter(
  (l) => l.data.publish && entry.data.nearbyAreas.includes(l.id) && l.id !== entry.id
);
const allServices = await getCollection('services');
const byId = Object.fromEntries(allServices.map((s) => [s.id, s]));
const groupedServices = serviceGroups
  .map((group) => ({
    ...group,
    services: group.serviceIds.map((id) => byId[id]).filter(Boolean),
  }))
  .filter((group) => group.services.length > 0);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations/' },
  { name: entry.data.title, path: `/locations/${entry.id}/` },
];
const jsonLd = [
  breadcrumbList(crumbs),
  serviceSchema({
    name: `Website development in ${entry.data.title}`,
    description: entry.data.excerpt,
    path: `/locations/${entry.id}/`,
    areaServed: entry.data.areaServed,
  }),
  faqSchema(entry.data.faqs),
].filter(Boolean);
---

<BaseLayout title={entry.data.seo.title} description={entry.data.seo.description} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Locations', href: '/locations/' },
          { label: entry.data.title },
        ]}
      />
      <h1>Website development in {entry.data.title}</h1>
      <p class="lead">{entry.data.excerpt}</p>
      <a class="btn btn--primary" href="/contact/" data-track="cta">Get a Quote</a>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container prose">
      <Content />
      <h2>Local context</h2>
      <p>{entry.data.localContext}</p>
      <p>
        We service {entry.data.title} as part of our Perth coverage. We do not claim a local office or showroom in{' '}
        {entry.data.title} unless one exists.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Services in {entry.data.title}</h2>
      <p class="section__lead">
        Every service has a local page for {entry.data.title} — pick the job you need.
      </p>
      {
        groupedServices.map((group) => (
          <div class="location-services">
            <h3>{group.title}</h3>
            <div class="tile-grid">
              {group.services.map((item) => {
                const Icon = getServiceIcon(item.id);
                return (
                  <a class="tile" href={serviceLocationPath(item.id, entry.id)}>
                    <Icon class="icon" size={22} stroke-width={1.75} />
                    <h4>{item.data.title}</h4>
                    <p>
                      {item.data.title} in {entry.data.title}
                    </p>
                    <span>View →</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {
    nearby.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Nearby areas</h2>
          <div class="tile-grid">
            {nearby.map((item) => (
              <a class="tile" href={`/locations/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>View →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FaqAccordion faqs={entry.data.faqs} />
  <CtaBand />
</BaseLayout>

<style>
  .location-services {
    margin-top: 2rem;
  }

  .location-services h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .location-services .tile-grid {
    margin-top: 0;
  }
</style>
