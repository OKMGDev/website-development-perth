---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articleSchema, breadcrumbList } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const services = await getCollection('services');
const related = services.filter((s) => entry.data.relatedServices.includes(s.id));
const published = entry.data.published.toISOString();
const updated = (entry.data.updated ?? entry.data.published).toISOString();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: entry.data.title, path: `/blog/${entry.id}/` },
];
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  jsonLd={[
    breadcrumbList(crumbs),
    articleSchema({
      title: entry.data.title,
      description: entry.data.excerpt,
      path: `/blog/${entry.id}/`,
      datePublished: published,
      dateModified: updated,
      author: entry.data.author,
    }),
  ]}
>
  <article>
    <section class="page-hero">
      <div class="container">
        <Breadcrumbs
          items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: entry.data.title }]}
        />
        <p class="section__eyebrow">{entry.data.category}</p>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.excerpt}</p>
        <p>
          By {entry.data.author} · Published {entry.data.published.toLocaleDateString('en-AU')}
          {entry.data.updated && ` · Updated ${entry.data.updated.toLocaleDateString('en-AU')}`}
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 0">
      <div class="container">
        {
          entry.data.takeaways.length > 0 && (
            <div class="takeaways">
              <h2>Key takeaways</h2>
              <ul>
                {entry.data.takeaways.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Related services</h2>
          <div class="tile-grid">
            {related.map((item) => (
              <a class="tile" href={`/services/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>View →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .takeaways {
    max-width: 48rem;
    margin-bottom: 2rem;
    padding: 1.25rem 1.4rem;
    border-left: 3px solid var(--sea);
    background: rgba(11, 110, 99, 0.06);
  }

  .takeaways h2 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }
</style>
