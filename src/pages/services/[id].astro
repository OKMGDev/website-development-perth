---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbList, faqSchema, serviceSchema } from '../../lib/seo';
import { serviceLocationPath } from '../../lib/serviceLocations';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const industries = await getCollection('industries');
const relatedIndustries = industries.filter((i) => entry.data.relatedIndustries.includes(i.id));
const services = await getCollection('services');
const relatedServices = services.filter((s) => entry.data.relatedServices.includes(s.id));
const locations = (await getCollection('locations'))
  .filter((l) => l.data.publish)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: entry.data.title, path: `/services/${entry.id}/` },
];

const jsonLd = [
  breadcrumbList(crumbs),
  serviceSchema({
    name: entry.data.title,
    description: entry.data.excerpt,
    path: `/services/${entry.id}/`,
  }),
  faqSchema(entry.data.faqs),
].filter(Boolean);
---

<BaseLayout title={entry.data.seo.title} description={entry.data.seo.description} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services/' },
          { label: entry.data.title },
        ]}
      />
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.excerpt}</p>
      {
        entry.data.glance && (
          <dl class="glance">
            <div>
              <dt>Who it’s for</dt>
              <dd>{entry.data.glance.who}</dd>
            </div>
            <div>
              <dt>Timeline</dt>
              <dd>{entry.data.glance.timeline}</dd>
            </div>
            <div>
              <dt>Platforms</dt>
              <dd>{entry.data.glance.platforms}</dd>
            </div>
            <div>
              <dt>Best when</dt>
              <dd>{entry.data.glance.bestWhen}</dd>
            </div>
          </dl>
        )
      }
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/" data-track="cta">Get a Quote</a>
        <a class="btn btn--ghost" href="/services/">All services</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container prose">
      <Content />
      <h2>What you get</h2>
      <ul>
        {entry.data.benefits.map((item) => <li>{item}</li>)}
      </ul>
      <h2>How we deliver</h2>
      <ol>
        {entry.data.process.map((item) => <li>{item}</li>)}
      </ol>
      <p>
        <a href="/contact/">Get a quote</a> for {entry.data.title.toLowerCase()} in Perth — tell us your goals and current setup.
      </p>
    </div>
  </section>

  {
    relatedIndustries.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Relevant industries</h2>
          <div class="tile-grid">
            {relatedIndustries.map((item) => (
              <a class="tile" href={`/industries/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>Explore →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    relatedServices.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Related services</h2>
          <div class="tile-grid">
            {relatedServices.map((item) => (
              <a class="tile" href={`/services/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>View →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    locations.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">{entry.data.title} by location</h2>
          <p class="section__lead">
            Local pages for each published Perth service area — same service, suburb-specific context.
          </p>
          <div class="tile-grid">
            {locations.map((item) => (
              <a class="tile" href={serviceLocationPath(entry.id, item.id)}>
                <h3>{item.data.title}</h3>
                <p>
                  {entry.data.title} in {item.data.title}
                </p>
                <span>View →</span>
              </a>
            ))}
          </div>
          <p class="section-link">
            <a href="/locations/">Browse all locations</a>
          </p>
        </div>
      </section>
    )
  }

  <FaqAccordion faqs={entry.data.faqs} title={`Questions about ${entry.data.title}`} />
  <CtaBand />
</BaseLayout>

<style>
  .page-hero .btn-row {
    margin-top: 1.5rem;
  }

  .section-link {
    margin-top: 1.5rem;
  }

  .section-link a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }

  .section-link a:hover {
    color: var(--ink);
  }
</style>
