---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbList, faqSchema, serviceSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const industries = await getCollection('industries');
const relatedIndustries = industries.filter((i) => entry.data.relatedIndustries.includes(i.id));
const services = await getCollection('services');
const relatedServices = services.filter((s) => entry.data.relatedServices.includes(s.id));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: entry.data.title, path: `/services/${entry.id}/` },
];

const jsonLd = [
  breadcrumbList(crumbs),
  serviceSchema({
    name: entry.data.title,
    description: entry.data.excerpt,
    path: `/services/${entry.id}/`,
  }),
  faqSchema(entry.data.faqs),
].filter(Boolean);
---

<BaseLayout title={entry.data.seo.title} description={entry.data.seo.description} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services/' },
          { label: entry.data.title },
        ]}
      />
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.excerpt}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/" data-track="cta">Get a Quote</a>
        <a class="btn btn--ghost" href="/services/">All services</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container prose">
      <Content />
      <h2>What you get</h2>
      <ul>
        {entry.data.benefits.map((item) => <li>{item}</li>)}
      </ul>
      <h2>How we deliver</h2>
      <ol>
        {entry.data.process.map((item) => <li>{item}</li>)}
      </ol>
      <p>
        <a href="/contact/">Get a quote</a> for {entry.data.title.toLowerCase()} in Perth — tell us your goals and current setup.
      </p>
    </div>
  </section>

  {
    relatedIndustries.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Relevant industries</h2>
          <div class="tile-grid">
            {relatedIndustries.map((item) => (
              <a class="tile" href={`/industries/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>Explore →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    relatedServices.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="section__title">Related services</h2>
          <div class="tile-grid">
            {relatedServices.map((item) => (
              <a class="tile" href={`/services/${item.id}/`}>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <span>View →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FaqAccordion faqs={entry.data.faqs} title={`Questions about ${entry.data.title}`} />
  <CtaBand />
</BaseLayout>
