---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbList } from '../lib/seo';
import { site } from '../data/site';
---

<BaseLayout
  title="Privacy Policy | Website Development Perth"
  description="How Website Development Perth collects and uses enquiry information."
  jsonLd={breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Privacy', path: '/privacy/' },
  ])}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
      <h1>Privacy policy</h1>
      <p class="lead">Last updated 23 July 2026. This is a working draft for launch and should be reviewed by the business owner.</p>
    </div>
  </section>
  <section class="section" style="padding-top: 0">
    <div class="container prose">
      <p>
        When you submit an enquiry through {site.name}, we collect the details you provide (such as name, email, phone,
        message and service interest) plus technical context like landing page, referrer and device information used to
        respond to your request.
      </p>
      <p>
        We use that information to reply to your enquiry, prepare quotes and improve our services. We do not sell your
        personal information. Form submissions may be processed by email and CRM tools configured for this site.
      </p>
      <p>
        Contact us at <a href={`mailto:${site.email}`}>{site.email}</a> or {site.phoneDisplay} if you have privacy questions
        or want to request access or correction of personal information we hold about you.
      </p>
    </div>
  </section>
</BaseLayout>
