---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const services = [
  'Custom Website Design',
  'WordPress Development',
  'Webflow Development',
  'Shopify Development',
  'WooCommerce Development',
  'Website Redesign',
  'Landing Page Design',
  'Website Maintenance',
  'SEO & Optimisation',
  'Other',
];
---

<form class:list={['enquiry', { 'enquiry--compact': compact }]} data-enquiry-form>
  <div class="enquiry__intro">
    <h2>{compact ? 'Get a quote' : 'Tell us about your project'}</h2>
    <p data-step-label>Step 1 of 2</p>
  </div>

  <div class="enquiry__step" data-step="1">
    <label>
      Full name
      <input name="name" required autocomplete="name" />
    </label>
    <label>
      Email
      <input name="email" type="email" required autocomplete="email" />
    </label>
    <label>
      Phone
      <input name="phone" type="tel" required autocomplete="tel" />
    </label>
    <label>
      How can we help?
      <select name="enquiryType" required>
        <option value="quote">Request a quote</option>
        <option value="quick">Quick enquiry</option>
        <option value="consultation">Book a consultation</option>
      </select>
    </label>
    <button type="button" class="btn btn--primary" data-next>Continue</button>
  </div>

  <div class="enquiry__step" data-step="2" hidden>
    <label>
      Service interest
      <select name="serviceInterest" required>
        <option value="" selected disabled>Select a service</option>
        {services.map((service) => <option value={service}>{service}</option>)}
      </select>
    </label>
    <label>
      Industry (optional)
      <input name="industry" placeholder="e.g. tradie, healthcare" />
    </label>
    <label>
      Message
      <textarea name="message" rows="4" required placeholder="What are you looking to achieve?"></textarea>
    </label>
    <label class="enquiry__consent">
      <input name="consent" type="checkbox" value="yes" required />
      <span>I agree to be contacted about this enquiry. See our <a href="/privacy/">privacy policy</a>.</span>
    </label>
    <div class="enquiry__actions">
      <button type="button" class="btn btn--ghost" data-back>Back</button>
      <button type="submit" class="btn btn--primary" data-submit>Send enquiry</button>
    </div>
    <p class="enquiry__error" data-error hidden role="alert"></p>
  </div>
</form>

<script>
  const form = document.querySelector('[data-enquiry-form]');
  if (form instanceof HTMLFormElement) {
    const step1 = form.querySelector('[data-step="1"]');
    const step2 = form.querySelector('[data-step="2"]');
    const label = form.querySelector('[data-step-label]');
    const errorEl = form.querySelector('[data-error]');
    const submitBtn = form.querySelector('[data-submit]');
    let started = false;
    let submitted = false;

    const track = (event: string, params: Record<string, unknown> = {}) => {
      window.gtag?.('event', event, { form_name: 'enquiry', ...params });
    };

    form.addEventListener('focusin', () => {
      if (!started) {
        started = true;
        track('form_start');
      }
    });

    window.addEventListener('pagehide', () => {
      if (started && !submitted) track('form_abandon');
    });

    form.querySelector('[data-next]')?.addEventListener('click', () => {
      const required = step1?.querySelectorAll('input, select') ?? [];
      for (const field of required) {
        if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
          if (!field.reportValidity()) return;
        }
      }
      if (step1 instanceof HTMLElement) step1.hidden = true;
      if (step2 instanceof HTMLElement) step2.hidden = false;
      if (label) label.textContent = 'Step 2 of 2';
      track('form_step', { step: 2 });
    });

    form.querySelector('[data-back]')?.addEventListener('click', () => {
      if (step2 instanceof HTMLElement) step2.hidden = true;
      if (step1 instanceof HTMLElement) step1.hidden = false;
      if (label) label.textContent = 'Step 1 of 2';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(errorEl instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) return;
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries());
      payload.landingPage = window.location.pathname;
      payload.referrer = document.referrer;
      payload.device = navigator.userAgent;
      payload.utm = window.location.search;

      try {
        const res = await fetch('/api/enquiry/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('fail');
        submitted = true;
        track('form_submit', { form_type: String(payload.enquiryType || '') });
        window.location.href = '/thank-you/';
      } catch {
        errorEl.textContent = 'Something went wrong. Please call us or try again.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .enquiry {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    padding: 1.5rem;
  }

  .enquiry--compact {
    padding: 1.25rem;
  }

  .enquiry__intro h2 {
    font-size: 1.35rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .enquiry__intro p {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .enquiry__step {
    display: grid;
    gap: 0.85rem;
    animation: rise 0.35s ease;
  }

  .enquiry__step[hidden] {
    display: none !important;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.7rem;
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.55rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    background: var(--bg-elevated);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 1px solid var(--accent);
    border-color: var(--accent);
  }

  textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .enquiry__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-muted);
  }

  .enquiry__consent input {
    width: auto;
    min-height: auto;
    margin-top: 0.2rem;
  }

  .enquiry__actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .enquiry__error {
    color: #b42318;
    font-size: 0.9rem;
  }
</style>
