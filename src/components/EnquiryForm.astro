---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const services = [
  'Custom Website Design',
  'WordPress Development',
  'Webflow Development',
  'Shopify Development',
  'WooCommerce Development',
  'Website Redesign',
  'Landing Page Design',
  'Website Maintenance',
  'SEO & Optimisation',
  'Other',
];
---

<form class:list={['enquiry', { 'enquiry--compact': compact }]} data-enquiry-form>
  <div class="enquiry__intro">
    <h2>{compact ? 'Get a quote' : 'Tell us about your project'}</h2>
    <p>We’ll reply with clear next steps.</p>
  </div>

  <div class="enquiry__fields">
    <label>
      Full name
      <input name="name" required autocomplete="name" />
    </label>
    <label>
      Email
      <input name="email" type="email" required autocomplete="email" />
    </label>
    <label>
      Phone
      <input name="phone" type="tel" required autocomplete="tel" />
    </label>
    <label>
      Service interest
      <select name="serviceInterest" required>
        <option value="" selected disabled>Select a service</option>
        {services.map((service) => <option value={service}>{service}</option>)}
      </select>
    </label>
    <label>
      Message
      <textarea name="message" rows="4" required placeholder="What are you looking to achieve?"></textarea>
    </label>
    <label class="enquiry__consent">
      <input name="consent" type="checkbox" value="yes" required />
      <span>I agree to be contacted about this enquiry. See our <a href="/privacy/">privacy policy</a>.</span>
    </label>
    <div class="enquiry__actions">
      <button type="submit" class="btn btn--primary" data-submit>Send enquiry</button>
    </div>
    <p class="enquiry__error" data-error hidden role="alert"></p>
  </div>
</form>

<script>
  const form = document.querySelector('[data-enquiry-form]');
  if (form instanceof HTMLFormElement) {
    const errorEl = form.querySelector('[data-error]');
    const submitBtn = form.querySelector('[data-submit]');
    let started = false;
    let submitted = false;

    const track = (event: string, params: Record<string, unknown> = {}) => {
      window.gtag?.('event', event, { form_name: 'enquiry', ...params });
    };

    form.addEventListener('focusin', () => {
      if (!started) {
        started = true;
        track('form_start');
      }
    });

    window.addEventListener('pagehide', () => {
      if (started && !submitted) track('form_abandon');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(errorEl instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement)) return;
      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries());
      payload.landingPage = window.location.pathname;
      payload.referrer = document.referrer;
      payload.device = navigator.userAgent;
      payload.utm = window.location.search;

      try {
        const res = await fetch('/api/enquiry/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await res.json().catch(() => ({}))) as { error?: string; detail?: string };
        if (!res.ok) {
          throw new Error(result.error || result.detail || 'fail');
        }
        submitted = true;
        track('form_submit', { form_type: String(payload.serviceInterest || '') });
        window.location.href = '/thank-you/';
      } catch (err) {
        const message = err instanceof Error && err.message !== 'fail' ? err.message : null;
        errorEl.textContent = message
          ? `${message}. Please call us or try again.`
          : 'Something went wrong. Please call us or try again.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .enquiry {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent);
    padding: 1.5rem;
  }

  .enquiry--compact {
    padding: 1.25rem;
  }

  .enquiry__intro h2 {
    font-size: 1.35rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .enquiry__intro p {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .enquiry__fields {
    display: grid;
    gap: 0.85rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.7rem;
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 0.55rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    background: var(--bg-elevated);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 1px solid var(--accent);
    border-color: var(--accent);
  }

  textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .enquiry__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-muted);
  }

  .enquiry__consent input {
    width: auto;
    min-height: auto;
    margin-top: 0.2rem;
  }

  .enquiry__actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .enquiry__error {
    color: #b42318;
    font-size: 0.9rem;
  }
</style>
