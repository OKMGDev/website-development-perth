---
import { ChevronDown } from '@lucide/astro';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = 'Common questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq section">
      <div class="container">
        <h2 class="section__title">{title}</h2>
        <div class="faq__list">
          {faqs.map((faq) => (
            <details class="faq__item">
              <summary>
                <span>{faq.question}</span>
                <ChevronDown class="faq__chevron" size={20} stroke-width={1.75} />
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__list {
    margin-top: 1.5rem;
    max-width: 48rem;
  }

  .faq__item {
    border-top: 1px solid var(--line);
    padding: 1.1rem 0;
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  details[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__item p {
    margin-top: 0.75rem;
    color: var(--ink-muted);
  }
</style>
