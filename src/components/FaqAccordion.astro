---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = 'Common questions' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq section">
      <div class="container">
        <h2 class="section__title">{title}</h2>
        <div class="faq__list">
          {faqs.map((faq) => (
            <details class="faq__item">
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__list {
    margin-top: 1.5rem;
    max-width: 48rem;
  }

  .faq__item {
    border-top: 1px solid var(--line);
    padding: 1rem 0;
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    cursor: pointer;
    font-weight: 650;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    color: var(--sea);
    font-weight: 700;
  }

  details[open] summary::after {
    content: '–';
  }

  .faq__item p {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }
</style>
