---
import { ArrowRight, Phone } from '@lucide/astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s build something that wins work',
  text = 'Tell us what you need. We’ll reply with clear next steps — no pressure, no jargon.',
} = Astro.props;
---

<section class="cta-band section">
  <div class="container cta-band__inner reveal-on-scroll">
    <div>
      <p class="section__eyebrow">Got 10 minutes?</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact/" data-track="cta">
        Get a Quote
        <ArrowRight size={16} stroke-width={1.75} />
      </a>
      <a class="btn btn--ghost" href={site.phoneHref} data-track="cta">
        <Phone size={16} stroke-width={1.75} />
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
  }

  .cta-band h2 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    max-width: 14ch;
  }

  .cta-band p {
    color: var(--ink-muted);
    max-width: 42ch;
  }

  @media (min-width: 800px) {
    .cta-band__inner {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
</style>
