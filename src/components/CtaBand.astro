---
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to talk about your website?',
  text = 'Tell us what you need. We’ll reply with clear next steps — no pressure, no jargon.',
} = Astro.props;
---

<section class="cta-band section">
  <div class="container cta-band__inner reveal-on-scroll">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
      <p class="cta-band__note">{site.responseTime}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact/" data-track="cta">Get a Quote</a>
      <a class="btn btn--ghost" href={site.phoneHref} data-track="cta">{site.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(11, 110, 99, 0.08), rgba(212, 196, 168, 0.25));
  }

  .cta-band h2 {
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    max-width: 16ch;
  }

  .cta-band p {
    color: var(--ink-soft);
    max-width: 42ch;
  }

  .cta-band__note {
    font-size: 0.9rem;
  }

  @media (min-width: 800px) {
    .cta-band__inner {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      padding: 2.5rem 3rem;
    }
  }
</style>
