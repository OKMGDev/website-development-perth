---
import { MessageSquareText, Phone } from '@lucide/astro';
import { site } from '../data/site';
---

<div class="sticky-cta" role="navigation" aria-label="Quick contact">
  <a class="sticky-cta__call" href={site.phoneHref} data-track="cta">
    <Phone size={16} stroke-width={1.75} />
    <span>Call</span>
  </a>
  <a class="sticky-cta__quote" href="/contact/" data-track="cta">
    <MessageSquareText size={16} stroke-width={1.75} />
    <span>Get a Quote</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: var(--sticky-h);
    border-top: 1px solid var(--line);
  }

  .sticky-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .sticky-cta__call {
    background: var(--bg-elevated);
    color: var(--ink);
  }

  .sticky-cta__quote {
    background: var(--accent);
    color: #fff;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
