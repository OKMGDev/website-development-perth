---
import { site } from '../data/site';
---

<div class="sticky-cta" role="navigation" aria-label="Quick contact">
  <a class="sticky-cta__call" href={site.phoneHref} data-track="cta">
    <span>Call</span>
  </a>
  <a class="sticky-cta__quote" href="/contact/" data-track="cta">
    <span>Get a Quote</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: var(--sticky-h);
    border-top: 1px solid var(--line);
  }

  .sticky-cta a {
    display: grid;
    place-items: center;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }

  .sticky-cta__call {
    background: var(--paper);
    color: var(--ink);
  }

  .sticky-cta__quote {
    background: var(--sea);
    color: #fff;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
