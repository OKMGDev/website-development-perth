---
import { getCollection } from 'astro:content';
import { Mail, MapPin, Phone } from '@lucide/astro';
import { footerNav, site } from '../data/site';
import { serviceGroups } from '../data/serviceGroups';

const allServices = await getCollection('services');
const byId = Object.fromEntries(allServices.map((s) => [s.id, s]));
const services = serviceGroups
  .flatMap((group) => group.serviceIds.map((id) => byId[id]))
  .filter(Boolean);
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand"><span>&lt;</span>WDP<span>&gt;</span></p>
      <p class="footer__blurb">{site.tagline} {site.serviceArea}.</p>
      <p class="footer__contact">
        <a href={site.phoneHref}>
          <Phone size={16} stroke-width={1.75} />
          {site.phoneDisplay}
        </a>
        <a href={`mailto:${site.email}`}>
          <Mail size={16} stroke-width={1.75} />
          {site.email}
        </a>
        {
          site.offices.map((office) => (
            <a href={office.mapsUrl} rel="noopener noreferrer" target="_blank">
              <MapPin size={16} stroke-width={1.75} />
              {office.formatted}
            </a>
          ))
        }
      </p>
    </div>

    <div class="footer__services">
      <h2>Services</h2>
      <ul>
        {services.map((item) => (
          <li><a href={`/services/${item.id}/`}>{item.data.title}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2>Company</h2>
      <ul>
        {footerNav.company.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="footer__operator">
      WDP is a digital showcase by <a href="https://okmg.com/" rel="noopener noreferrer" target="_blank">OKMG</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 4rem 0 2rem;
    background: #0a1218;
    border-top: 1px solid transparent;
    color: rgba(255, 255, 255, 0.68);
  }

  .footer a {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
  }

  .footer a:hover {
    color: #fff;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.85rem;
  }

  .footer__brand span {
    color: #e10f0d;
  }

  .footer__blurb {
    max-width: 28ch;
    margin-bottom: 1.25rem;
  }

  .footer__contact {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .footer__contact a,
  .footer__contact span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__contact .lucide {
    color: #ff6b69;
  }

  .footer h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.95rem;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer li {
    margin-bottom: 0.45rem;
    font-size: 0.92rem;
  }

  .footer__services ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.25rem;
    row-gap: 0.35rem;
  }

  .footer__services li {
    margin-bottom: 0;
  }

  .muted {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.88rem;
  }

  .footer__operator {
    margin: 0;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer__operator a {
    color: rgba(255, 255, 255, 0.68);
  }

  .footer__bottom {
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.88rem;
  }

  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 1.2fr 1.6fr 1fr;
    }
  }
</style>
