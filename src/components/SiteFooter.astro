---
import { getCollection } from 'astro:content';
import { Mail, MapPin, Phone } from '@lucide/astro';
import { footerNav, site } from '../data/site';
import { featuredServiceIds } from '../data/serviceGroups';

const allServices = await getCollection('services');
const byId = Object.fromEntries(allServices.map((s) => [s.id, s]));
const services = featuredServiceIds.map((id) => byId[id]).filter(Boolean);
const locations = (await getCollection('locations'))
  .filter((l) => l.data.publish)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">website<span>/</span>perth</p>
      <p class="footer__blurb">{site.tagline} {site.serviceArea}.</p>
      <p class="footer__contact">
        <a href={site.phoneHref}>
          <Phone size={16} stroke-width={1.75} />
          {site.phoneDisplay}
        </a>
        <a href={`mailto:${site.email}`}>
          <Mail size={16} stroke-width={1.75} />
          {site.email}
        </a>
        <span>
          <MapPin size={16} stroke-width={1.75} />
          {site.address}
        </span>
      </p>
      <p class="muted">ABN {site.abn} (placeholder)</p>
    </div>

    <div>
      <h2>Services</h2>
      <ul>
        {services.map((item) => (
          <li><a href={`/services/${item.id}/`}>{item.data.title}</a></li>
        ))}
        <li><a href="/services/">All services →</a></li>
      </ul>
    </div>

    <div>
      <h2>Company</h2>
      <ul>
        {footerNav.company.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2>Service areas</h2>
      <ul>
        {locations.map((item) => (
          <li><a href={`/locations/${item.id}/`}>{item.data.title}</a></li>
        ))}
        <li><a href="/locations/">View all areas →</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="muted">{site.responseTime}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 4rem 0 2rem;
    background: #0a1218;
    border-top: 1px solid transparent;
    color: rgba(255, 255, 255, 0.68);
  }

  .footer a {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
  }

  .footer a:hover {
    color: #fff;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.85rem;
  }

  .footer__brand span {
    color: var(--accent);
  }

  .footer__blurb {
    max-width: 28ch;
    margin-bottom: 1.25rem;
  }

  .footer__contact {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .footer__contact a,
  .footer__contact span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__contact .lucide {
    color: #ff6b69;
  }

  .footer h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.95rem;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer li {
    margin-bottom: 0.45rem;
    font-size: 0.92rem;
  }

  .muted {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.88rem;
  }

  .footer__bottom {
    margin-top: 2.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.88rem;
  }

  @media (min-width: 900px) {
    .footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
    }
  }
</style>
