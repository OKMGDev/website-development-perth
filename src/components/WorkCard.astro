---
import { Picture } from 'astro:assets';
import { formatFacetLabel } from '../lib/portfolio';

interface Props {
  id: string;
  title: string;
  excerpt: string;
  image?: string | null;
  categories?: string[];
  headingLevel?: 'h2' | 'h3';
  filterable?: boolean;
  /** First-row cards above the fold can opt into eager loading. */
  imageLoading?: 'lazy' | 'eager';
}

const {
  id,
  title,
  excerpt,
  image = null,
  categories = [],
  headingLevel = 'h2',
  filterable = false,
  imageLoading = 'lazy',
} = Astro.props;

const Heading = headingLevel;
const tags = categories.filter(Boolean);
const isRemote = typeof image === 'string' && /^https?:\/\//i.test(image);
---

<a
  class="work-card"
  href={`/work/${id}/`}
  data-work-card={filterable ? '' : undefined}
  data-title={filterable ? title : undefined}
  data-excerpt={filterable ? excerpt : undefined}
  data-categories={filterable ? tags.join(',') : undefined}
>
  {
    image && isRemote ? (
      <Picture
        src={image}
        alt={`${title} website project`}
        width={640}
        height={400}
        widths={[320, 640]}
        sizes="(max-width: 719px) 100vw, (max-width: 999px) 50vw, 33vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        quality={75}
        loading={imageLoading}
        decoding="async"
        class="work-card__img"
      />
    ) : image ? (
      <img
        src={image}
        alt={`${title} website project`}
        loading={imageLoading}
        decoding="async"
        width="640"
        height="400"
        class="work-card__img"
      />
    ) : null
  }
  <div class:list={['work-card__body', !image && 'work-card__body--no-image']}>
    {tags.length > 0 && (
      <p class="work-card__tags">{tags.map((tag) => formatFacetLabel(tag)).join(' · ')}</p>
    )}
    <Heading>{title}</Heading>
    <p>{excerpt}</p>
    <span>View project →</span>
  </div>
</a>

<style>
  .work-card {
    display: grid;
    align-content: start;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .work-card[hidden] {
    display: none;
  }

  .work-card:hover {
    border-color: var(--ink);
  }

  .work-card :global(picture),
  .work-card :global(img.work-card__img),
  .work-card .work-card__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    background: var(--mist);
  }

  .work-card :global(picture img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .work-card__body {
    padding: 0 1.15rem 1.15rem;
  }

  .work-card__body--no-image {
    padding-top: 1.15rem;
  }

  .work-card__tags {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.45rem;
  }

  .work-card :is(h2, h3) {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .work-card p {
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }

  .work-card span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
